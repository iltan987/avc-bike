<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Everything not excluded is still backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Volume levels from the phone the music was turned down on; restoring them on another
             phone would change its volume at first launch. -->
        <exclude domain="sharedpref" path="quiet_memory.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quiet_memory.xml" />
    </device-transfer>
</data-extraction-rules>
