<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AVCBike" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme: dashboard-colored splash with the gauge icon, then the app theme. -->
    <style name="Theme.AVCBike.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AVCBike</item>
    </style>
</resources>
